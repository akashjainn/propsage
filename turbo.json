{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DEMO_MODE",
    "VIDEO_ENABLED",
    "PPLX_API_KEY",
    "TWELVELABS_API_KEY",
    "TWELVELABS_INDEX_ID",
    "R2_ENDPOINT",
    "VIDEO_BUCKET_NAME",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "TWELVELABS_BASE_URL",
    "BALLDONTLIE_API_KEY",
    "REDIS_URL",
    "FEATURE_FLAGS",
    "WEB_BASE_URL",
    "CORS_ORIGIN",
    "ODDS_API_KEY",
    "SPORTSDATAIO_API_KEY",
    "SPORTRADAR_API_KEY",
    "MSF_API_KEY",
    "MSF_ENABLED",
    "MSF_POLLING_ENABLED",
    "MSF_BASE_URL"
  ],
  "tasks": {
    "build": { 
      "dependsOn": ["^build"], 
      "outputs": ["dist/**", ".next/**"],
      "env": [
        "DEMO_MODE",
        "VIDEO_ENABLED",
        "PPLX_API_KEY",
        "TWELVELABS_API_KEY",
        "TWELVELABS_INDEX_ID",
        "R2_ENDPOINT",
        "VIDEO_BUCKET_NAME",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "TWELVELABS_BASE_URL",
        "BALLDONTLIE_API_KEY",
        "REDIS_URL",
        "FEATURE_FLAGS",
        "WEB_BASE_URL",
        "CORS_ORIGIN",
        "ODDS_API_KEY",
        "SPORTSDATAIO_API_KEY",
        "SPORTRADAR_API_KEY",
        "MSF_API_KEY",
        "MSF_ENABLED",
        "MSF_POLLING_ENABLED",
        "MSF_BASE_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_API_WS_URL",
        "NEXT_PUBLIC_DEMO_MODE",
        "NEXT_PUBLIC_VIDEO_ENABLED",
        "NEXT_PUBLIC_FEATURE_TL",
        "NEXT_PUBLIC_TWELVELABS_INDEX_ID"
      ]
    },
    "dev": { "cache": false },
    "lint": {},
    "test": { "dependsOn": ["^build"], "outputs": [] }
  }
}
